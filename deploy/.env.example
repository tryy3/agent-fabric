# Copy to deploy/.env and adjust.

# GHCR images (use :main until you cut a release tag; :latest after merge to main)
CONTROLPLANE_IMAGE=ghcr.io/tryy3/agent-fabric/controlplane:main
CLIENT_WEB_IMAGE=ghcr.io/tryy3/agent-fabric/client-web:main

# Published HTTP port (client-web nginx)
HTTP_PORT=8080

# Postgres
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agentfabric

# Host engine config mounted into controlplane
PLANE_CONFIG=./config.json

# Docker socket for compose.sandbox.yaml (do not mount the host docker binary).
#
# Rootful (system docker.service):
#   DOCKER_SOCK=/var/run/docker.sock
#
# Rootless (dockerd-rootless) — use this if the sock shows as nobody:nobody
# inside the container:
#   DOCKER_SOCK=/run/user/1000/docker.sock   # = $XDG_RUNTIME_DIR/docker.sock
DOCKER_SOCK=/var/run/docker.sock
#
# GID that owns DOCKER_SOCK on the host:
#   stat -c '%g' "$DOCKER_SOCK"
DOCKER_GID=999

# Optional: pin Flutter catalog/ACP URLs (empty = same-origin from browser)
# CATALOG_BASE=https://your-machine.tailnet.ts.net
# ACP_URI=wss://your-machine.tailnet.ts.net/acp
