{
  "extraKnownMarketplaces": {
    "pstack-claude": {
      "source": {
        "source": "git",
        "url": "https://github.com/michael-denyer/pstack-claude.git"
      }
    }
  },
  "enabledPlugins": {
    "pstack@pstack-claude": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "direnv export bash >> \"$CLAUDE_ENV_FILE\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud/session-env.sh"
          }
        ],
        "matcher": "startup|resume"
      }
    ]
  }
}
